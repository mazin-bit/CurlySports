# Copy to .env and set values
# JWT secret (min 32 chars in production)
JWT_SECRET=change-me-in-production-min-32-chars

# Main sports app URL (Members are redirected here after login)
# NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3000
# MAIN_APP_URL=http://localhost:3000

# PostgreSQL connection string
# DATABASE_URL="postgresql://user:password@localhost:5432/sports_analytics?schema=public"
