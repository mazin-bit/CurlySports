generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  username      String         @unique
  name          String?
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  emailVerified Boolean        @default(false)
  favTeam       Json?
  googleId      String?        @unique
  passwordHash  String?
  otpHash       String?
  otpExpiresAt  DateTime?
  otpAttempts   Int            @default(0)
  otpSentAt     DateTime?
  debateVotes   DebateVote[]
  favorites     Favorite[]
  predictions   Prediction[]
  userFavorites UserFavorite[]

  @@map("users")
}

model League {
  id        String   @id @default(cuid())
  espnId    String?  @unique
  name      String
  shortName String
  sport     Sport
  country   String?
  logoUrl   String?
  season    String?
  createdAt DateTime @default(now())
  matches   Match[]
  teams     Team[]

  @@map("leagues")
}

model Team {
  id          String     @id @default(cuid())
  espnId      String?    @unique
  name        String
  shortName   String
  logoUrl     String?
  city        String?
  country     String?
  sport       Sport
  leagueId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  favorites   Favorite[]
  awayMatches Match[]    @relation("AwayTeam")
  homeMatches Match[]    @relation("HomeTeam")
  players     Player[]
  league      League?    @relation(fields: [leagueId], references: [id])

  @@map("teams")
}

model Player {
  id          String     @id @default(cuid())
  name        String
  position    String?
  nationality String?
  age         Int?
  photoUrl    String?
  teamId      String?
  sport       Sport
  stats       Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  favorites   Favorite[]
  team        Team?      @relation(fields: [teamId], references: [id])

  @@map("players")
}

model Match {
  id          String       @id @default(cuid())
  espnId      String?      @unique
  homeTeamId  String
  awayTeamId  String
  leagueId    String?
  homeScore   Int?
  awayScore   Int?
  status      MatchStatus  @default(SCHEDULED)
  sport       Sport
  scheduledAt DateTime
  startedAt   DateTime?
  finishedAt  DateTime?
  minute      Int?
  period      String?
  venue       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  awayTeam    Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeTeam    Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  league      League?      @relation(fields: [leagueId], references: [id])
  predictions Prediction[]

  @@map("matches")
}

model News {
  id          String   @id @default(cuid())
  espnId      String?  @unique
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  imageUrl    String?
  sport       Sport?
  source      String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news")
}

model Debate {
  id        String       @id @default(cuid())
  question  String
  optionA   String
  optionB   String
  sport     Sport?
  votesA    Int          @default(0)
  votesB    Int          @default(0)
  isLive    Boolean      @default(true)
  expiresAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  votes     DebateVote[]

  @@map("debates")
}

model DebateVote {
  id        String   @id @default(cuid())
  debateId  String
  userId    String
  option    String
  createdAt DateTime @default(now())
  debate    Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([debateId, userId])
  @@map("debate_votes")
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  points    Int      @default(0)
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@map("predictions")
}

model UserFavorite {
  id        String   @id @default(cuid())
  userId    String
  type      String
  espnId    String
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, espnId])
  @@map("user_favorites_v2")
}

model Favorite {
  id       String  @id @default(cuid())
  userId   String
  teamId   String?
  playerId String?
  player   Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team     Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@unique([userId, playerId])
  @@map("favorites")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  category  String
  subject   String
  message   String
  rating    Int?
  status    String   @default("open")
  createdAt DateTime @default(now())

  @@map("feedback")
}

enum Sport {
  FOOTBALL
  BASKETBALL
  NFL
  TENNIS
  BASEBALL
  F1
  CRICKET
  HOCKEY
  GOLF
  BOXING
}

enum MatchStatus {
  SCHEDULED
  LIVE
  HALF_TIME
  FINISHED
  POSTPONED
  CANCELLED
}
