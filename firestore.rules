rules_version = '2';
// RBAC: role is stored in users/{uid}.role as 'super_admin' | 'admin' | 'member'
// Only super_admin can write role to admin/super_admin; admin can write role to member.

service cloud.firestore {
  // Safe getRole: if user doc missing, treat as member so rules don't throw
  function getRole() {
    return exists(/databases/$(db)/documents/users/$(request.auth.uid))
      ? get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('role', 'member')
      : 'member';
  }
  function isSuperAdmin() {
    return getRole() == 'super_admin';
  }
  function isAdmin() {
    return getRole() == 'admin' || isSuperAdmin();
  }
  function isAllowlistedSuperAdmin() {
    return request.auth != null
      && request.auth.token.email != null
      && request.auth.token.email in [
        'mazcis2011@gmail.com',
        'mazinn@gmail.com',
        'nasarpk20@gmail.com',
        'nasar@gmail.com',
        'nasarpk@gmail.com'
      ];
  }
  // User is super admin by role OR by email in config OR by allowlist
  function isEffectiveSuperAdmin() {
    return isSuperAdmin()
      || isAllowlistedSuperAdmin()
      || (exists(/databases/$(db)/documents/config/app)
          && get(/databases/$(db)/documents/config/app).data.get('super_admin_emails', {}).get(request.auth.token.email, false) == true);
  }
  function isEffectiveAdmin() {
    return isAdmin() || isEffectiveSuperAdmin();
  }

  match /databases/{db}/documents {
    match /users/{userId} {
      // Users can read own doc; super_admin and admin can read ALL users (by role or by config list)
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || isEffectiveAdmin()
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      // Own doc: allow any update EXCEPT changing role (so favorites, streak, etc. work)
      allow update: if request.auth != null && request.auth.uid == userId
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      // Bootstrap: allow user to upgrade own role from member to super_admin once (other fields may be included)
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        && resource.data.get('role', 'member') == 'member'
        && request.resource.data.role == 'super_admin';
      // Self-elevate admin -> super_admin so User Management / Streak Leaderboard sync works when added as super_admin in app
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        && resource.data.get('role', 'member') == 'admin'
        && request.resource.data.role == 'super_admin';
      allow delete: if false;

      // Role assignment: only super_admin can set admin/super_admin; admin or super_admin can set member (for OTHER users)
      allow update: if request.auth != null && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && (
          (request.resource.data.role == 'member' && (isEffectiveAdmin()))
          || (request.resource.data.role == 'admin' && isEffectiveSuperAdmin())
          || (request.resource.data.role == 'super_admin' && isEffectiveSuperAdmin())
        );
      // Streak reset: admin/super_admin (by role or config) can set currentStreak/longestStreak on other users
      allow update: if request.auth != null && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentStreak', 'longestStreak'])
        && isEffectiveAdmin();
      // Status change: admin/super_admin can set status (active, suspended, banned) on other users
      allow update: if request.auth != null && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && isEffectiveAdmin();
    }

    // App config (feature flags, admins, maintenance) — public read; write if user is super_admin (by role, allowlist, or by email in list)
    // Fallback: any authenticated user can write so dashboard toggles work (restrict Super Admin UI access in app if needed).
    match /config/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
