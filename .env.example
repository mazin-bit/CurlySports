# Vite dev server port
VITE_PORT=3000

# Supabase Configuration (required for login and dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Get the anon (public) key from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth Client ID (required for Google sign-in)
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Prisma migrations (optional – get from Supabase Dashboard → Settings → Database)
# If password has { } ; # encode them: {=%7B }=%7D ;=%3B #=%23
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres"
